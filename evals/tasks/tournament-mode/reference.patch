+import { Trophy } from 'lucide-react'
+import { useState, type FormEvent } from 'react'
+import type { Player } from '../lib/types'
+
+type Props = {
+  players: Player[]
+  onCreate: (name: string, playerIds: string[]) => Promise<void>
+}
+
+export function CreateTournamentForm({ players, onCreate }: Props) {
+  const [name, setName] = useState('')
+  const [selected, setSelected] = useState<string[]>([])
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+
+  function toggle(id: string) {
+    setSelected((ids) => (ids.includes(id) ? ids.filter((x) => x !== id) : [...ids, id]))
+  }
+
+  async function handleSubmit(event: FormEvent) {
+    event.preventDefault()
+    setPending(true)
+    setError(null)
+    try {
+      await onCreate(name, selected)
+      setName('')
+      setSelected([])
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Could not create the tournament.')
+    } finally {
+      setPending(false)
+    }
+  }
+
+  return (
+    <form onSubmit={(event) => void handleSubmit(event)} className="space-y-3">
+      <label className="block text-xs font-semibold uppercase tracking-wider text-felt-50/70">
+        Name
+        <input
+          value={name}
+          onChange={(event) => setName(event.target.value)}
+          className="mt-1.5 w-full rounded-lg border border-white/10 bg-felt-950/60 px-3 py-2 text-sm text-cream outline-none focus:border-gold/70"
+        />
+      </label>
+      <fieldset className="grid grid-cols-2 gap-1.5 text-sm">
+        <legend className="mb-1.5 text-xs font-semibold uppercase tracking-wider text-felt-50/70">
+          Players ({selected.length})
+        </legend>
+        {players.map((player) => (
+          <label key={player.id} className="flex items-center gap-2 text-cream">
+            <input type="checkbox" checked={selected.includes(player.id)} onChange={() => toggle(player.id)} />
+            {player.name}
+          </label>
+        ))}
+      </fieldset>
+      {error ? <p className="text-sm text-rod-red">{error}</p> : null}
+      <button
+        type="submit"
+        disabled={pending || !name.trim() || selected.length < 2}
+        className="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-cream px-3 py-2 text-sm font-semibold text-felt-950 disabled:opacity-50"
+      >
+        <Trophy size={16} />
+        {pending ? 'Creating…' : 'Create tournament'}
+      </button>
+    </form>
+  )
+}
