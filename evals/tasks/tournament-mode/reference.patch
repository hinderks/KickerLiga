+++ b/supabase/migrations/0003_tournaments.sql
@@ -0,0 +1,225 @@
+-- Tournament mode: knockout brackets on top of the league.
+-- Spec: specs/tournament-mode.md (reference solution for lecture 8).
+
+create table if not exists kl_tournaments (
+  id uuid primary key default gen_random_uuid(),
+  season_id uuid not null references kl_seasons (id),
+  name text not null,
+  size integer not null,
+  created_at timestamptz not null default now(),
+  finished_at timestamptz,
+  champion_id uuid references kl_players (id),
+  constraint kl_tournaments_name_not_blank check (char_length(trim(name)) > 0),
+  constraint kl_tournaments_size_power_of_two check (size in (2, 4, 8, 16, 32))
+);
+
+create table if not exists kl_tournament_entries (
+  tournament_id uuid not null references kl_tournaments (id),
+  player_id uuid not null references kl_players (id),
+  seed integer not null,
+  primary key (tournament_id, player_id),
+  unique (tournament_id, seed)
+);
+
+create table if not exists kl_tournament_matches (
+  id uuid primary key default gen_random_uuid(),
+  tournament_id uuid not null references kl_tournaments (id),
+  round integer not null,
+  slot integer not null,
+  player1_id uuid references kl_players (id),
+  player2_id uuid references kl_players (id),
+  winner_id uuid references kl_players (id),
+  match_id uuid references kl_matches (id),
+  unique (tournament_id, round, slot)
+);
+
+alter table kl_tournaments enable row level security;
+alter table kl_tournament_entries enable row level security;
+alter table kl_tournament_matches enable row level security;
+
+create policy kl_tournaments_select on kl_tournaments
+  for select to anon, authenticated using (true);
+create policy kl_tournament_entries_select on kl_tournament_entries
+  for select to anon, authenticated using (true);
+create policy kl_tournament_matches_select on kl_tournament_matches
+  for select to anon, authenticated using (true);
+
+grant select on table kl_tournaments to anon, authenticated;
+grant select on table kl_tournament_entries to anon, authenticated;
+grant select on table kl_tournament_matches to anon, authenticated;
+
+-- Puts a winner into the next round (spec: "Advancing"). After the final it
+-- closes the tournament instead. Internal helper, not executable by clients.
+create or replace function kl_tournament_advance(
+  p_tournament_id uuid,
+  p_round integer,
+  p_slot integer,
+  p_winner_id uuid
+)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  rounds integer;
+begin
+  select round(log(2, size))::integer into rounds from kl_tournaments where id = p_tournament_id;
+
+  if p_round >= rounds then
+    update kl_tournaments
+      set finished_at = now(), champion_id = p_winner_id
+      where id = p_tournament_id;
+    return;
+  end if;
+
+  if p_slot % 2 = 1 then
+    update kl_tournament_matches set player1_id = p_winner_id
+      where tournament_id = p_tournament_id and round = p_round + 1 and slot = (p_slot + 1) / 2;
+  else
+    update kl_tournament_matches set player2_id = p_winner_id
+      where tournament_id = p_tournament_id and round = p_round + 1 and slot = p_slot / 2;
+  end if;
+end;
+$$;
+
+revoke all on function kl_tournament_advance(uuid, integer, integer, uuid) from public, anon, authenticated;
+
+create or replace function kl_create_tournament(p_name text, p_player_ids uuid[])
+returns kl_tournaments
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  n integer := coalesce(cardinality(p_player_ids), 0);
+  bracket integer := 2;
+  rounds integer;
+  season_id_open uuid;
+  seed_order integer[] := array[1, 2];
+  next_order integer[];
+  s integer;
+  r integer;
+  k integer;
+  seed_a integer;
+  seed_b integer;
+  p1 uuid;
+  p2 uuid;
+  result kl_tournaments;
+begin
+  if p_name is null or char_length(trim(p_name)) = 0 then
+    raise exception 'Enter a name for the tournament.';
+  end if;
+  if n < 2 or n > 32 then
+    raise exception 'A tournament needs 2 to 32 players.';
+  end if;
+  if (select count(distinct id) from unnest(p_player_ids) as id) <> n then
+    raise exception 'A player appears twice.';
+  end if;
+  if (select count(*) from kl_players where id = any (p_player_ids)) <> n then
+    raise exception 'One of the players is missing.';
+  end if;
+
+  select id into season_id_open from kl_seasons where closed_at is null for share;
+  if season_id_open is null then
+    raise exception 'There is no open season.';
+  end if;
+
+  while bracket < n loop
+    bracket := bracket * 2;
+  end loop;
+  rounds := round(log(2, bracket))::integer;
+
+  insert into kl_tournaments (season_id, name, size)
+    values (season_id_open, trim(p_name), bracket)
+    returning * into result;
+
+  insert into kl_tournament_entries (tournament_id, player_id, seed)
+  select result.id, p.id, row_number() over (order by p.elo desc, lower(p.name) asc, p.id)::integer
+    from kl_players p
+    where p.id = any (p_player_ids);
+
+  -- Every match of every round; later rounds start empty.
+  for r in 1..rounds loop
+    insert into kl_tournament_matches (tournament_id, round, slot)
+    select result.id, r, slot from generate_series(1, bracket / (2 ^ r)::integer) as slot;
+  end loop;
+
+  -- Standard seed order: order(2m) replaces every s in order(m) by s, 2m + 1 - s.
+  while cardinality(seed_order) < bracket loop
+    next_order := array[]::integer[];
+    foreach s in array seed_order loop
+      next_order := next_order || s || (2 * cardinality(seed_order) + 1 - s);
+    end loop;
+    seed_order := next_order;
+  end loop;
+
+  for k in 1..(bracket / 2) loop
+    seed_a := seed_order[2 * k - 1];
+    seed_b := seed_order[2 * k];
+    select player_id into p1 from kl_tournament_entries where tournament_id = result.id and seed = seed_a;
+    p2 := null;
+    if seed_b <= n then
+      select player_id into p2 from kl_tournament_entries where tournament_id = result.id and seed = seed_b;
+    end if;
+
+    update kl_tournament_matches
+      set player1_id = p1, player2_id = p2, winner_id = case when p2 is null then p1 end
+      where tournament_id = result.id and round = 1 and slot = k;
+
+    if p2 is null then
+      perform kl_tournament_advance(result.id, 1, k, p1);
+    end if;
+  end loop;
+
+  return result;
+end;
+$$;
+
+revoke all on function kl_create_tournament(text, uuid[]) from public;
+grant execute on function kl_create_tournament(text, uuid[]) to anon, authenticated;
+
+create or replace function kl_play_tournament_match(
+  p_match_id uuid,
+  p_score1 integer,
+  p_score2 integer
+)
+returns kl_tournament_matches
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  tm kl_tournament_matches;
+  league kl_matches;
+  winner uuid;
+begin
+  select * into tm from kl_tournament_matches where id = p_match_id for update;
+  if tm.id is null then
+    raise exception 'Tournament match not found.';
+  end if;
+  if tm.winner_id is not null then
+    raise exception 'This match has already been played.';
+  end if;
+  if tm.player1_id is null or tm.player2_id is null then
+    raise exception 'This match is not ready: a player is still missing.';
+  end if;
+  if p_score1 = p_score2 then
+    raise exception 'A knockout match cannot end in a draw.';
+  end if;
+
+  league := kl_record_match(tm.player1_id, tm.player2_id, p_score1, p_score2);
+  winner := case when p_score1 > p_score2 then tm.player1_id else tm.player2_id end;
+
+  update kl_tournament_matches
+    set winner_id = winner, match_id = league.id
+    where id = tm.id
+    returning * into tm;
+
+  perform kl_tournament_advance(tm.tournament_id, tm.round, tm.slot, winner);
+  return tm;
+end;
+$$;
+
+revoke all on function kl_play_tournament_match(uuid, integer, integer) from public;
+grant execute on function kl_play_tournament_match(uuid, integer, integer) to anon, authenticated;
