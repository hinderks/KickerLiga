+
+export async function listTournaments(): Promise<Tournament[]> {
+  const { data, error } = await supabase
+    .from('kl_tournaments')
+    .select('*')
+    .order('created_at', { ascending: false })
+
+  if (error) throw new Error(messageFor(error, 'Could not load tournaments.'))
+  return data ?? []
+}
+
+export async function listTournamentMatches(tournamentId: string): Promise<TournamentMatch[]> {
+  const { data, error } = await supabase
+    .from('kl_tournament_matches')
+    .select('*')
+    .eq('tournament_id', tournamentId)
+    .order('round', { ascending: true })
+    .order('slot', { ascending: true })
+
+  if (error) throw new Error(messageFor(error, 'Could not load the bracket.'))
+  return data ?? []
+}
+
+export async function createTournament(name: string, playerIds: string[]): Promise<Tournament> {
+  const trimmed = name.trim()
+  if (!trimmed) throw new Error('Enter a name for the tournament.')
+  if (playerIds.length < 2) throw new Error('Pick at least two players.')
+
+  const { data, error } = await supabase.rpc('kl_create_tournament', {
+    p_name: trimmed,
+    p_player_ids: playerIds,
+  })
+
+  if (error) throw new Error(messageFor(error, 'Could not create the tournament.'))
+  if (!data) throw new Error('Could not create the tournament.')
+  return data as Tournament
+}
+
+export async function playTournamentMatch(
+  matchId: string,
+  score1: number,
+  score2: number,
+): Promise<TournamentMatch> {
+  if (!Number.isInteger(score1) || !Number.isInteger(score2) || score1 < 0 || score2 < 0) {
+    throw new Error('Scores must be whole numbers of 0 or more.')
+  }
+  if (score1 === score2) throw new Error('A knockout match cannot end in a draw.')
+
+  const { data, error } = await supabase.rpc('kl_play_tournament_match', {
+    p_match_id: matchId,
+    p_score1: score1,
+    p_score2: score2,
+  })
+
+  if (error) throw new Error(messageFor(error, 'Could not record the result.'))
+  if (!data) throw new Error('Could not record the result.')
+  return data as TournamentMatch
+}
