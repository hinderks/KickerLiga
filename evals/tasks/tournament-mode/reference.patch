+import { describe, expect, it } from 'vitest'
+import { roundCount, roundLabel, seedOrder } from './bracket'
+
+describe('seedOrder', () => {
+  it('returns the standard order for powers of two', () => {
+    expect(seedOrder(2)).toEqual([1, 2])
+    expect(seedOrder(4)).toEqual([1, 4, 2, 3])
+    expect(seedOrder(8)).toEqual([1, 8, 4, 5, 2, 7, 3, 6])
+  })
+
+  it('keeps seeds 1 and 2 in different halves', () => {
+    const order = seedOrder(32)
+    expect(order.indexOf(1)).toBeLessThan(16)
+    expect(order.indexOf(2)).toBeGreaterThanOrEqual(16)
+  })
+
+  it('throws for sizes that are no power of two', () => {
+    expect(() => seedOrder(6)).toThrow()
+    expect(() => seedOrder(1)).toThrow()
+    expect(() => seedOrder(0)).toThrow()
+  })
+})
+
+describe('roundCount and roundLabel', () => {
+  it('counts rounds', () => {
+    expect(roundCount(2)).toBe(1)
+    expect(roundCount(16)).toBe(4)
+  })
+
+  it('names the last three rounds', () => {
+    expect(roundLabel(4, 4)).toBe('Final')
+    expect(roundLabel(3, 4)).toBe('Semi-final')
+    expect(roundLabel(2, 4)).toBe('Quarter-final')
+    expect(roundLabel(1, 4)).toBe('Round 1')
+  })
+})
