+import { Crown } from 'lucide-react'
+import { useState, type FormEvent } from 'react'
+import { roundCount, roundLabel } from '../lib/bracket'
+import type { Player, Tournament, TournamentMatch } from '../lib/types'
+
+type Props = {
+  tournament: Tournament
+  bracket: TournamentMatch[]
+  players: Player[]
+  onPlay: (matchId: string, score1: number, score2: number) => Promise<void>
+}
+
+export function TournamentBracket({ tournament, bracket, players, onPlay }: Props) {
+  const rounds = roundCount(tournament.size)
+  const nameOf = (id: string | null) => players.find((p) => p.id === id)?.name ?? null
+  const champion = nameOf(tournament.champion_id)
+
+  return (
+    <div className="space-y-4">
+      <div className="flex items-baseline justify-between gap-3">
+        <p className="font-display text-2xl tracking-wide text-cream">{tournament.name}</p>
+        {champion ? (
+          <p className="inline-flex items-center gap-1.5 text-sm font-semibold text-gold">
+            <Crown size={16} /> {champion}
+          </p>
+        ) : null}
+      </div>
+      <div className="grid gap-4 overflow-x-auto" style={{ gridTemplateColumns: `repeat(${rounds}, minmax(12rem, 1fr))` }}>
+        {Array.from({ length: rounds }, (_, i) => i + 1).map((round) => (
+          <div key={round} className="flex flex-col justify-around gap-3">
+            <p className="text-xs font-semibold uppercase tracking-wider text-felt-50/60">
+              {roundLabel(round, rounds)}
+            </p>
+            {bracket
+              .filter((m) => m.round === round)
+              .map((match) => (
+                <BracketMatch key={match.id} match={match} nameOf={nameOf} onPlay={onPlay} />
+              ))}
+          </div>
+        ))}
+      </div>
+    </div>
+  )
+}
+
+type MatchProps = {
+  match: TournamentMatch
+  nameOf: (id: string | null) => string | null
+  onPlay: Props['onPlay']
+}
+
+function BracketMatch({ match, nameOf, onPlay }: MatchProps) {
+  const [score1, setScore1] = useState('')
+  const [score2, setScore2] = useState('')
+  const [error, setError] = useState<string | null>(null)
+  const playable = match.player1_id && match.player2_id && !match.winner_id
+  const bye = match.player1_id && !match.player2_id && match.winner_id
+
+  async function handleSubmit(event: FormEvent) {
+    event.preventDefault()
+    setError(null)
+    try {
+      await onPlay(match.id, Number.parseInt(score1, 10), Number.parseInt(score2, 10))
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Could not record the result.')
+    }
+  }
+
+  const row = (id: string | null, fallback: string) => (
+    <p className={`truncate text-sm ${id && id === match.winner_id ? 'font-semibold text-gold' : 'text-cream'}`}>
+      {nameOf(id) ?? fallback}
+    </p>
+  )
+
+  return (
+    <div className="rounded-lg border border-white/10 bg-felt-950/60 p-2.5">
+      {row(match.player1_id, 'TBD')}
+      {row(match.player2_id, bye ? 'bye' : 'TBD')}
+      {playable ? (
+        <form onSubmit={(event) => void handleSubmit(event)} className="mt-2 flex items-center gap-1.5">
+          <input aria-label="Score player 1" type="number" min={0} value={score1} onChange={(e) => setScore1(e.target.value)} className="w-12 rounded border border-white/10 bg-felt-900 px-1.5 py-1 text-sm text-cream" />
+          <input aria-label="Score player 2" type="number" min={0} value={score2} onChange={(e) => setScore2(e.target.value)} className="w-12 rounded border border-white/10 bg-felt-900 px-1.5 py-1 text-sm text-cream" />
+          <button type="submit" disabled={score1 === '' || score2 === ''} className="rounded bg-cream px-2 py-1 text-xs font-semibold text-felt-950 disabled:opacity-50">
+            Save
+          </button>
+        </form>
+      ) : null}
+      {error ? <p className="mt-1 text-xs text-rod-red">{error}</p> : null}
+    </div>
+  )
+}
