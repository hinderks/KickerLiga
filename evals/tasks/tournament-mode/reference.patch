@@ -0,0 +1,28 @@
+// Pure helpers for the knockout bracket (specs/tournament-mode.md).
+
+// Standard seed order: order(2) = [1, 2]; order(2m) replaces every s in
+// order(m) by s, 2m + 1 - s. Seeds 1 and 2 can only meet in the final.
+export function seedOrder(size: number): number[] {
+  if (!Number.isInteger(size) || size < 2 || (size & (size - 1)) !== 0) {
+    throw new Error(`Bracket size must be a power of two of at least 2, got ${size}.`)
+  }
+  let order = [1, 2]
+  while (order.length < size) {
+    const m = order.length
+    order = order.flatMap((s) => [s, 2 * m + 1 - s])
+  }
+  return order
+}
+
+export function roundCount(size: number): number {
+  return Math.log2(seedOrder(size).length)
+}
+
+// Label of a round counted from 1, given the number of rounds.
+export function roundLabel(round: number, rounds: number): string {
+  const fromEnd = rounds - round
+  if (fromEnd === 0) return 'Final'
+  if (fromEnd === 1) return 'Semi-final'
+  if (fromEnd === 2) return 'Quarter-final'
+  return `Round ${round}`
+}
