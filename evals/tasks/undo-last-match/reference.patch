+export async function undoLastMatch(): Promise<Match> {
+  const { data, error } = await supabase.rpc('kl_undo_last_match')
+
+  if (error) throw new Error(messageFor(error, 'Could not undo the last match.'))
+  if (!data) throw new Error('Could not undo the last match.')
+  return data as Match
+}
