@@ -0,0 +1,29 @@
+-- Undo the latest match of the open season (eval reference).
+
+create or replace function kl_undo_last_match()
+returns kl_matches
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  last kl_matches;
+begin
+  select m.* into last
+    from kl_matches m join kl_seasons s on s.id = m.season_id
+    where s.closed_at is null
+    order by m.played_at desc, m.id desc
+    limit 1
+    for update of m;
+  if last.id is null then
+    raise exception 'There is no match in the open season.';
+  end if;
+  update kl_players set elo = last.player1_elo_before where id = last.player1_id;
+  update kl_players set elo = last.player2_elo_before where id = last.player2_id;
+  delete from kl_matches where id = last.id;
+  return last;
+end;
+$$;
+
+revoke all on function kl_undo_last_match() from public;
+grant execute on function kl_undo_last_match() to anon, authenticated;
