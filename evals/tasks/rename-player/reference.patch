+
+export async function renamePlayer(playerId: string, newName: string): Promise<Player> {
+  const name = newName.trim()
+  if (!name) throw new Error('Enter a player name.')
+
+  const { data, error } = await supabase
+    .from('kl_players')
+    .update({ name })
+    .eq('id', playerId)
+    .select()
+    .single()
+
+  if (error) throw new Error(messageFor(error, 'Could not rename player.'))
+  return data
+}
