 }
+
+export type HeadToHead = { played: number; a_wins: number; b_wins: number; draws: number }
+
+export async function headToHead(playerAId: string, playerBId: string): Promise<HeadToHead> {
+  const { data, error } = await supabase.rpc('kl_head_to_head', {
+    p_player_a: playerAId,
+    p_player_b: playerBId,
+  })
+
+  if (error) throw new Error(messageFor(error, 'Could not load head-to-head.'))
+  return data as HeadToHead
+}
