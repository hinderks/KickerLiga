+-- Head-to-head statistics (eval reference).
+
+create or replace function kl_head_to_head(p_player_a uuid, p_player_b uuid)
+returns json
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  result json;
+begin
+  if (select count(*) from kl_players where id in (p_player_a, p_player_b)) <> 2 then
+    raise exception 'One of the players is missing.';
+  end if;
+  select json_build_object(
+    'played', count(*)::integer,
+    'a_wins', count(*) filter (where a_goals > b_goals)::integer,
+    'b_wins', count(*) filter (where a_goals < b_goals)::integer,
+    'draws', count(*) filter (where a_goals = b_goals)::integer
+  ) into result
+  from (
+    select score1 as a_goals, score2 as b_goals from kl_matches
+      where player1_id = p_player_a and player2_id = p_player_b
+    union all
+    select score2, score1 from kl_matches
+      where player1_id = p_player_b and player2_id = p_player_a
+  ) as games;
+  return result;
+end;
+$$;
+
+revoke all on function kl_head_to_head(uuid, uuid) from public;
+grant execute on function kl_head_to_head(uuid, uuid) to anon, authenticated;
