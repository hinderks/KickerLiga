   if (delta < 0) return String(delta)
   return '0'
 }
+
+export function winRate(record: PlayerRecord): number {
+  if (record.played === 0) return 0
+  return Math.round(((record.wins + record.draws / 2) / record.played) * 1000) / 1000
+}
