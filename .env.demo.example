# Second Supabase project, only for the lecture 7 demo.
# seed_db and npm run demo:reset DROP ALL TABLES in this database.
# Never enter the course project here; scripts/demo-db.ts refuses it.
# Copy to .env.demo (ignored by git). The agent may not read .env files.

# Project ref, e.g. the subdomain of VITE_SUPABASE_URL
KL_DEMO_PROJECT_REF=
# Connection string with password, percent-encoded
# (Supabase dashboard: Connect, session pooler)
KL_DEMO_DB_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
