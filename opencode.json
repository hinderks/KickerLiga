            "provider": {
              "order": [
                "Alibaba"
              ],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.demo.example": "allow"
    },
    "edit": {
      "*": "allow",
      "tests/acceptance/*": "deny",
      "vite.config.ts": "deny",
      "vitest.acceptance.config.ts": "deny",
      "eslint.config.js": "deny",
      "tsconfig*.json": "deny",
      "package.json": "deny",
      "package-lock.json": "deny",
      "scripts/*": "deny",
      "supabase/seed.sql": "deny",
      "supabase/config.toml": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      ".opencode/*": "deny",
      "*.env*": "deny"
    },
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run typecheck": "allow",
      "npm run lint": "allow",
      "npm run build": "allow",
      "git status *": "allow",
